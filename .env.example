# ==========================================
# Meeting System - Production Environment Variables
# ==========================================

# Proje & API Ayarları
PROJECT_NAME="Yebsoft Görüntülü ve Sesli Toplantı Yönetim Sistemi"
API_V1_STR="/api/v1"

# Veritabanı Ayarları (PostgreSQL Production Connection)
DATABASE_URL="postgresql://yebsoft_user:YebsoftSecretPassword2026!@db:5432/meeting_system_prod"

# Connection Pooling Ayarları
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# Güvenlik & JWT Ayarları (CANLIDA DEĞİŞTİRİN!)
SECRET_KEY="yebsoft_super_secure_crypto_secret_key_2026_jwt"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Otomatik tohumlanan demo/ilk kullanıcı hesaplarının (admin@yebsoft.net dahil)
# varsayılan giriş şifresi. CANLIYA ÇIKMADAN ÖNCE MUTLAKA GÜÇLÜ BİR DEĞERLE DEĞİŞTİRİN!
SEED_DEFAULT_PASSWORD="ChangeThisBeforeGoingLive_2026!"

# Profil Resmi Yükleme Ayarları
AVATAR_UPLOAD_DIR="app/static/avatars"
MAX_AVATAR_SIZE_MB=5

# STUN / TURN (Coturn) Sunucu Ayarları
TURN_SERVER_URL="turn:turn.bodor.com.tr:3478"
TURN_USERNAME="yebsoft_turn_user"
TURN_CREDENTIAL="yebsoft_turn_password_2026"
STUN_SERVER_URL="stun:stun.l.google.com:19302"

# CORS İzin Verilen Domainler (Virgülle Ayrılmış) — "*" KULLANMAYIN, credentials
# ile birlikte herhangi bir siteye kimlik bilgili istek atma izni verir.
ALLOWED_ORIGINS="https://meeting.bodor.com.tr"
