# ==========================================================================
# Meeting System — Ortam Değişkenleri Şablonu
# ==========================================================================
# Bu dosyayı ".env" olarak kopyalayıp AŞAĞIDAKİ HER DEĞERİ KENDİ ORTAMINIZA
# GÖRE DOLDURUN. docker-compose.yml ve nginx bu dosyayı otomatik okur — kod
# dosyalarının hiçbirini elle değiştirmeniz gerekmez.
#
#   cp .env.example .env
#
# ==========================================================================

# --- Proje / API ---
PROJECT_NAME="Kurumsal Toplantı Yönetim Sistemi"
API_V1_STR="/api/v1"

# --- Kendi sunucunuzun domain'i (SSL sertifikası ve CORS için kullanılır) ---
# Gerçek bir domain'iniz yoksa "localhost" bırakabilirsiniz (kendinden imzalı
# sertifika ile HTTPS de yine çalışır, sadece tarayıcı uyarı gösterir).
DOMAIN=your-domain.com

# --- PostgreSQL (Docker Compose bu üçünden DATABASE_URL'i otomatik kurar) ---
POSTGRES_USER=meeting_app_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
POSTGRES_DB=meeting_system_prod

# --- JWT / Oturum Güvenliği (CANLIYA ÇIKMADAN ÖNCE MUTLAKA DEĞİŞTİRİN) ---
# Rastgele güçlü bir değer üretmek için: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_RANDOM_LONG_SECRET
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- İlk kurulum / demo verisi ---
# SEED_DEMO_DATA=true yaparsanız uygulama ilk açılışta örnek departman +
# 20 demo kullanıcı (admin@yebsoft.net dahil) oluşturur — SADECE deneme/
# tanıtım ortamları için. Gerçek kullanıcıların bağlanacağı bir kurulumda
# bunu "false" bırakın (varsayılan), kullanıcılar normal kayıt akışından gelsin.
SEED_DEMO_DATA=false
# SEED_DEMO_DATA=true ise, oluşturulan demo hesapların şifresi bu olur —
# demo verisi açıksa MUTLAKA değiştirin.
SEED_DEFAULT_PASSWORD=CHANGE_ME_BEFORE_GOING_LIVE

# --- CORS: Yalnızca gerçekten kullanılacak domain(ler) — "*" KULLANMAYIN ---
ALLOWED_ORIGINS=https://your-domain.com

# --- STUN/TURN (WebRTC medya geçişi için coturn konteynerine kimlik bilgisi) ---
# ÖNEMLİ: Bu iki değeri değiştirirseniz, app/static/js/webrtc.js dosyasındaki
# getIceServers() fonksiyonunda HARD-CODE edilmiş aynı iki değeri de
# güncellemeniz gerekir — istemci tarafı statik JS dosyaları .env'i okuyamaz.
# Değiştirmezseniz aşağıdaki varsayılanları olduğu gibi bırakabilirsiniz.
TURN_USERNAME=yebsoft_turn_user
TURN_CREDENTIAL=yebsoft_turn_password_2026

# --- Profil Resmi Yükleme ---
AVATAR_UPLOAD_DIR="app/static/avatars"
MAX_AVATAR_SIZE_MB=5

# --- Connection Pooling (genelde varsayılanlar yeterli) ---
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# --- Docker dışı / bare-metal yerel çalıştırma için (python -m uvicorn) ---
# Docker Compose kullanıyorsanız bu satır gerekmez (yukarıdaki POSTGRES_*
# değerlerinden otomatik kurulur); sadece Docker'sız yerel geliştirmede kullanılır.
# DATABASE_URL=postgresql://meeting_app_user:CHANGE_ME_STRONG_DB_PASSWORD@localhost:5432/meeting_system_prod
